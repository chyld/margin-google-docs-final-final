{
  "favorites": 4,
  "images": 2,
  "notes": 2,
  "styles": 3,
}
`;

exports[`moving an account to another > reports what an account owns (the refusal message uses these) 2`] = `[Error: "alice" owns 2 note(s), 2 image(s), 3 style(s) and 4 favorite font(s). Use --transfer-to <user> or --purge]`;
